Options -Indexes

RewriteEngine On

# Evitar listar los archivos del directorio
IndexIgnore *

# Si es un directorio válido, no hacer nada
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Ocultar extensión .php (permite acceder a /admin/users sin poner .php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Redirigir de .php a la URL limpia (opcional, si quieres forzar a que no se vea el .php en el navegador)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Allow direct access to all PHP files in this directory
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

# Set index file
DirectoryIndex index.php
